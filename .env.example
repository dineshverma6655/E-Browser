PORT=3000
NEXT_PUBLIC_STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"

DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# TURN_URL=turn:your.turn.host:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chat-media
R2_ALLOWED_ORIGINS=http://localhost:3000

NEXT_PUBLIC_SECRET_CODE=your-secret-code

# ---- Split hosting (frontend on Vercel, backend on Render/Railway) ----
# Frontend (Vercel) env:  NEXT_PUBLIC_BACKEND_URL=https://your-backend.onrender.com   (leave empty when everything is on one host)
# Backend (Render) env:   CORS_ORIGIN=https://your-app.vercel.app                     (comma separated for several origins)
NEXT_PUBLIC_BACKEND_URL=
CORS_ORIGIN=
